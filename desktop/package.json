{
  "name": "mushaf-desktop",
  "productName": "المصحف",
  "version": "1.3.1",
  "description": "مصحف المدينة - نسخة سطح المكتب (AppImage)",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mosalah30688.mushaf",
    "productName": "المصحف",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "app/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "artifactName": "Mushaf-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mosalah30688-gif",
      "repo": "quran",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "Mushaf-${version}-portable.${ext}"
    }
  }
}
